FROM python:3.12-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pytest==8.3.4 pytest-asyncio==0.25.2

COPY sample_500.csv train.py serve.py config.py ./
COPY domain/ ./domain/
COPY adapters/ ./adapters/
COPY api/ ./api/
COPY templates/ ./templates/
COPY prompts/ ./prompts/
RUN python train.py

COPY tests/ ./tests/

ENV MODEL_PATH=/app/model.joblib \
    PROMPT_PATH=/app/prompts/system_prompt.txt \
    PYTHONPATH=/app \
    PORT=8081

CMD ["pytest", "tests/", "-v", "--disable-warnings"]
